<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tally defaults to dark whatever the system is set to, so the launch
         window stays dark here too — matching the first composed frame. -->
    <style name="Theme.Tally" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tally_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Tally.Main</item>
    </style>
</resources>
