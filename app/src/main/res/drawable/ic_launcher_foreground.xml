<?xml version="1.0" encoding="utf-8"?>
<!-- Compound growth: a line that only rises, and rises faster the further it
     goes. The identical cubic as tools/make-icons.mjs in the web repo, in the
     same 108x108 space, so every rendering of the mark — vector, PNG mipmap,
     favicon — is one shape. It sits inside the 72dp circle a launcher may
     crop to. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Scaled to about three quarters. A launcher crops this to a circle or
         a squircle of 72 in this 108 space and then scales the result up, so
         art drawn to the full safe zone comes out looking oversized on the
         home screen — which is what it did. The legacy PNG mipmaps are not
         cropped and are deliberately left at full size. -->
    <group android:scaleX="0.76" android:scaleY="0.76" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M32,74 C47.4,71.6 61.9,62 76,34"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="9.5"
            android:strokeLineCap="round" />
    </group>
</vector>
