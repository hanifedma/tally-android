# Copy to `keystore.properties` (same folder) and fill in, and release builds
# are signed with your own key instead of falling back to the debug one.
#
# Neither this file's real counterpart nor the keystore it points at is tracked
# by git — .gitignore covers `keystore.properties` and `*.jks`. Back both up
# somewhere private: Android identifies an app by its signing certificate, so
# losing the key means never being able to ship an update to the same install.
# It is also the certificate Google checks when signing in, so replacing it
# means registering a new SHA-1 (see SETUP.md).
#
# storeFile is resolved relative to the repository root.

storeFile=tally-release.jks
storePassword=CHANGE_ME
keyAlias=tally
keyPassword=CHANGE_ME
